<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="digital_twin">

  <xacro:property name="sphere_x" value="${0.2}"/>
  <xacro:property name="sphere_y" value="${-0.4}"/>
  <xacro:property name="sphere_z" value="${0.2}"/>

  <xacro:property name="red_sphere_x" value="${0.2}"/>
  <xacro:property name="red_sphere_y" value="${-0.4}"/>
  <xacro:property name="red_sphere_z" value="${0.1}"/>

  <xacro:property name="orbit_radius" value="${sqrt(red_sphere_x*red_sphere_x + red_sphere_z*red_sphere_z)}"/>

  <link name="red_sphere">
    <inertial>
      <mass value="0.0001"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.09"/>
      </geometry>
    </collision>
  </link>

   <joint name="joint_name" type="fixed">
    <parent link="world"/>
    <child link="red_sphere"/>
    <origin xyz="${red_sphere_x} ${red_sphere_y} ${red_sphere_z}" rpy="0 0 0"/>
   </joint>
<!-- 
  <link name="black_sphere">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.09"/>
      </geometry>
    </collision>
  </link>

  <joint name="world_to_black_sphere" type="fixed">
    <parent link="world"/>
    <child link="black_sphere"/>
    <origin xyz="${sphere_x} ${sphere_y} ${sphere_z}" rpy="0 0 0"/>
  </joint>
-->
</robot>
