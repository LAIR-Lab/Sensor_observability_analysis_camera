<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="digital_twin">

    <ros2_control name="Robot_control" type="system">

        <hardware>
             <plugin>gz_ros2_control/GazeboSimSystem</plugin>
         </hardware>
         
        <joint name="joint_0">
          <command_interface name="position"/>
          <state_interface name="position"/>
        </joint>

        <joint name="joint_1">
          <command_interface name="position"/>
          <state_interface name="position"/>
        </joint>

        <joint name="joint_2">
          <command_interface name="position"/>
          <state_interface name="position"/>
        </joint>

        <joint name="joint_3">
           <command_interface name="position" />
          <state_interface name="position"/>
        </joint>

        <joint name="joint_4">
           <command_interface name="position"/>
          <state_interface name="position"/>
        </joint>

        <joint name="joint_5">
          <command_interface name="position"/>
          <state_interface name="position"/>
        </joint>

    </ros2_control>
</robot>