<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="digital_twin">

  <xacro:property name="sphere_x" value="${0.2}"/>
  <xacro:property name="sphere_y" value="${-0.4}"/>
  <xacro:property name="sphere_z" value="${0.2}"/>
  <xacro:property name="orbit_radius" value="${sqrt(sphere_x*sphere_x + sphere_z*sphere_z)}"/>
  

  <link name="red_sphere">
    <inertial>
      <mass value="0.0001"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.09"/>
      </geometry>
    </collision>
  </link>

  <link name="orbit_pivot">
    <inertial>
      <mass value="0.0001"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>

  <!-- Massless intermediate link: this is what actually rotates, in place at the pivot -->
  <link name="orbit_arm">
    <inertial>
      <mass value="0.0001"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
    <!-- Visible rod so you can confirm rotation even independent of red_sphere -->
    <visual>
      <origin xyz="${orbit_radius/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${orbit_radius} 0.01 0.01"/>
      </geometry>
      <material name="yellow">
        <color rgba="1 1 0 0"/>
      </material>
    </visual>
  </link>

  <joint name="world_to_orbit_pivot" type="fixed">
    <parent link="world"/>
    <child link="orbit_pivot"/>
    <origin xyz="0 ${sphere_y} ${sphere_z}" rpy="0 0 0"/>
  </joint>

  <!-- Joint name kept as-is to match existing controllers.yaml / ros2_control config.
       Rotation happens here, at zero offset, so no naming changes needed elsewhere. -->
  <joint name="orbit_pivot_to_red_sphere" type="continuous">
    <parent link="orbit_pivot"/>
    <child link="orbit_arm"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- Offset happens here, AFTER rotation, so red_sphere's actual TF position sweeps the circle -->
  <joint name="arm_to_red_sphere" type="fixed">
    <parent link="orbit_arm"/>
    <child link="red_sphere"/>
    <origin xyz="${orbit_radius} 0 0" rpy="0 0 0"/>
  </joint>

  <ros2_control name="orbit_sphere_control" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="orbit_pivot_to_red_sphere">
      <command_interface name="velocity">
        <param name="min">-1.0</param>
        <param name="max">1.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <!--
  <joint name="world_to_red_sphere" type="fixed">
    <parent link="world"/>
    <child link="red_sphere"/>
    <origin xyz="${sphere_x} ${sphere_y} ${sphere_z}" rpy="0 0 0"/>
  </joint>


  <link name="black_sphere">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.09"/>
      </geometry>
    </collision>
  </link>

  <joint name="world_to_black_sphere" type="fixed">
    <parent link="world"/>
    <child link="black_sphere"/>
    <origin xyz="${sphere_x} ${sphere_y} ${sphere_z}" rpy="0 0 0"/>
  </joint>

-->
  
</robot>
